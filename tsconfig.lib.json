{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": "./src/xmlExplorer"
  },
  "include": ["src/xmlExplorer/**/*.ts", "src/xmlExplorer/**/*.tsx"],
  "exclude": [
    "src/assets/btTree.ts"
  ]
}
